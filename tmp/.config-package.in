		 Kernel module for Microchip MCP23xxx I/O expander via I2C
		 

	config PACKAGE_kmod-pinctrl-mcp23s08-spi
		tristate "kmod-pinctrl-mcp23s08-spi.......... Microchip MCP23xxx I/O expander (SPI)"
		default y if DEFAULT_kmod-pinctrl-mcp23s08-spi
		default m if ALL||ALL_NONSHARED||ALL_KMODS
		depends on GPIO_SUPPORT
		select PACKAGE_kmod-pinctrl-mcp23s08
