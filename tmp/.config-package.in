	config PACKAGE_kmod-w1-slave-ds2433
		tristate "kmod-w1-slave-ds2433............................ DS2433 4kb EEPROM driver"
		default y if DEFAULT_kmod-w1-slave-ds2433
		default m if ALL||ALL_NONSHARED||ALL_KMODS
		depends on PACKAGE_kmod-w1
