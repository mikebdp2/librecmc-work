		select PACKAGE_kmod-hid
		select PACKAGE_kmod-crypto-ecb
		select PACKAGE_kmod-crypto-hash
		help
		 Kernel support for Bluetooth devices
		 

	config PACKAGE_kmod-bluetooth-6lowpan
