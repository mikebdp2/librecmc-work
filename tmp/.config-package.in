	config PACKAGE_ddns-scripts
		tristate "ddns-scripts.............. Dynamic DNS Client scripts (with IPv6 support)"
		default y if DEFAULT_ddns-scripts
		default m if ALL
		select PACKAGE_ddns-scripts-services
		select PACKAGE_libc
		help
		 Dynamic DNS Client scripts (with IPv6 support)
		   A highly configurable set of scripts for doing dynamic dns updates.
		   - IPv6 support
		   - DNS server support
		   - Glue Record support (require BIND host or KNOT host)
		   - DNS requests via TCP
		   - Proxy server support
		   - log file support
		   - support to run once
		   Version: 2.8.2-42
		   Info   : https://openwrt.org/docs/guide-user/services/ddns/client
		 

	config PACKAGE_ddns-scripts-cloudflare
