		select PACKAGE_openssh-sftp-server
		select PACKAGE_avahi-dbus-daemon if PACKAGE_avahi-nodbus-daemon<PACKAGE_openssh-sftp-avahi-service
		select PACKAGE_libc
		help
		 This package contains the service definition for announcing
