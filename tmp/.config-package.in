	config PACKAGE_tor
		tristate "tor............................................ Tor routing daemon (full)"
		default y if DEFAULT_tor
		default m if ALL
		select PACKAGE_libevent2
		select PACKAGE_libopenssl
		select PACKAGE_libc
		select PACKAGE_librt
		select PACKAGE_libcap
		select PACKAGE_libpthread
		select PACKAGE_zlib
		depends on m || (PACKAGE_tor-basic != y)
		help
		 Tor is a toolset for a wide range of organizations and people that want to
		 improve their safety and security on the Internet. Using Tor can help you
		 anonymize web browsing and publishing, instant messaging, IRC, SSH, and
		 more. Tor also provides a platform on which software developers can build
		 new applications with built-in anonymity, safety, and privacy features.
		 
		 This package contains the full tor daemon.
		 
		 https://www.torproject.org/
		 Hauke Mehrtens <hauke@hauke-m.de> Peter Wagner <tripolar@gmx.at>

	config PACKAGE_tor-basic
		tristate "tor-basic................... Tor routing daemon (no bridge/relay support)"
		default y if DEFAULT_tor-basic
		default m if ALL
		select PACKAGE_libcap
		select PACKAGE_libpthread
		select PACKAGE_zlib
		select PACKAGE_libevent2
		select PACKAGE_libopenssl
		select PACKAGE_libc
		select PACKAGE_librt
		help
		 Tor is a toolset for a wide range of organizations and people that want to
		 improve their safety and security on the Internet. Using Tor can help you
		 anonymize web browsing and publishing, instant messaging, IRC, SSH, and
		 more. Tor also provides a platform on which software developers can build
		 new applications with built-in anonymity, safety, and privacy features.
		 
		 This package contains the basic tor daemon, without bridge/relay support.
		 
		 https://www.torproject.org/
		 Hauke Mehrtens <hauke@hauke-m.de> Peter Wagner <tripolar@gmx.at>

	config PACKAGE_tor-gencert
		tristate "tor-gencert................................... Tor certificate generation"
		default y if DEFAULT_tor-gencert
		default m if ALL
		depends on PACKAGE_tor
		select PACKAGE_libc
		help
		 Tor is a toolset for a wide range of organizations and people that want to
		 improve their safety and security on the Internet. Using Tor can help you
		 anonymize web browsing and publishing, instant messaging, IRC, SSH, and
		 more. Tor also provides a platform on which software developers can build
		 new applications with built-in anonymity, safety, and privacy features.
		 
		 Generate certs and keys for Tor directory authorities.
		 
		 https://www.torproject.org/
		 Hauke Mehrtens <hauke@hauke-m.de> Peter Wagner <tripolar@gmx.at>

	config PACKAGE_tor-geoip
		tristate "tor-geoip............................................... GeoIP db for tor"
		default y if DEFAULT_tor-geoip
		default m if ALL
		depends on PACKAGE_tor-basic||PACKAGE_tor
		select PACKAGE_libc
		help
		 Tor is a toolset for a wide range of organizations and people that want to
		 improve their safety and security on the Internet. Using Tor can help you
		 anonymize web browsing and publishing, instant messaging, IRC, SSH, and
		 more. Tor also provides a platform on which software developers can build
		 new applications with built-in anonymity, safety, and privacy features.
		 
		 This package contains a GeoIP database mapping IP addresses to countries.
		 
		 https://www.torproject.org/
		 Hauke Mehrtens <hauke@hauke-m.de> Peter Wagner <tripolar@gmx.at>

	config PACKAGE_tor-resolve
		tristate "tor-resolve......................................... tor hostname resolve"
		default y if DEFAULT_tor-resolve
		default m if ALL
		depends on PACKAGE_tor-basic||PACKAGE_tor
		select PACKAGE_libc
		help
		 Tor is a toolset for a wide range of organizations and people that want to
		 improve their safety and security on the Internet. Using Tor can help you
		 anonymize web browsing and publishing, instant messaging, IRC, SSH, and
		 more. Tor also provides a platform on which software developers can build
		 new applications with built-in anonymity, safety, and privacy features.
		 
		 Resolve a hostname to an IP address via tor.
		 
		 https://www.torproject.org/
		 Hauke Mehrtens <hauke@hauke-m.de> Peter Wagner <tripolar@gmx.at>

