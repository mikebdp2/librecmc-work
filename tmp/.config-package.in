		 Toke Høiland-Jørgensen <toke@toke.dk>

	config PACKAGE_adblock
		tristate "adblock... Powerful adblock script to block ad/abuse domains by using DNS"
		default y if DEFAULT_adblock
		default m if ALL
		select PACKAGE_opkg
		select PACKAGE_jshn
		select PACKAGE_ca-bundle
		select PACKAGE_coreutils-sort
		select PACKAGE_coreutils
		select PACKAGE_libc
		select PACKAGE_jsonfilter
		help
		 Powerful adblock solution to block ad/abuse domains via dnsmasq, unbound, named or kresd.
		 The script supports many domain blacklist sites plus manual black- and whitelist overrides.
		 Please see https://github.com/openwrt/packages/blob/master/net/adblock/files/README.md for further information.
		 
		 Dirk Brenken <dev@brenken.org>

	config PACKAGE_adblock-fast
		tristate "adblock-fast........................................ AdBlock Fast Service"
		default y if DEFAULT_adblock-fast
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_grep if !BUSYBOX_DEFAULT_GREP
		select PACKAGE_curl
		select PACKAGE_sed if !BUSYBOX_DEFAULT_SED
		select PACKAGE_gawk if !BUSYBOX_DEFAULT_AWK
		depends on !(!BUSYBOX_DEFAULT_SORT) || PACKAGE_coreutils
		select PACKAGE_jshn
		select PACKAGE_coreutils-sort if !BUSYBOX_DEFAULT_SORT
		help
		 Fast AdBlocking script to block ad or abuse/malware domains with DNSMASQ or Unbound.
		 Script supports local/remote list of domains and hosts-files for both block-listing and allow-listing.
		 Please see https://docs.openwrt.melmac.net/adblock-fast/ for more information.
		 https://docs.openwrt.melmac.net/adblock-fast/
		 Stan Grishin <stangri@melmac.ca>

	config PACKAGE_bpftool-full
		tristate "bpftool-full..................... bpftool - eBPF subsystem utility (Full)"
		default y if DEFAULT_bpftool-full
		default m if ALL
		select PACKAGE_libbfd
		select PACKAGE_libelf
		select PACKAGE_libc
		select PACKAGE_libopcodes
		help
		 A tool for inspection and simple manipulation of eBPF programs and maps.
		   This full version uses libbfd and libopcodes to support disassembly of
		   eBPF programs and jited code.
		 http://www.kernel.org
		 Tony Ambardar <itugrok@yahoo.com>

	config PACKAGE_bpftool-minimal
		tristate "bpftool-minimal............... bpftool - eBPF subsystem utility (Minimal)"
		default y if DEFAULT_bpftool-minimal
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libelf
		help
		 A tool for inspection and simple manipulation of eBPF programs and maps.
		 http://www.kernel.org
		 Tony Ambardar <itugrok@yahoo.com>

	config PACKAGE_chat
		tristate "chat................................. Establish conversation with a modem"
		default y if DEFAULT_chat
		default m if ALL
		select PACKAGE_libc
		help
		 This package contains an utility to establish conversation with other PPP servers
		 (via a modem).
		 https://ppp.samba.org/
		 Felix Fietkau <nbd@nbd.name>

	config PACKAGE_darkstat
		tristate "darkstat....................................... Network bandwidth monitor"
		default y if DEFAULT_darkstat
		default m if ALL
		select PACKAGE_libpcap
		select PACKAGE_zlib
		select PACKAGE_libc
		help
		 darkstat is a packet sniffer that runs as a background process on a cable/DSL
		 router, gathers all sorts of statistics about network usage, and serves them
		 over HTTP.
		 http://unix4lyfe.org/darkstat/
		 Jean-Michel Lacroix <lacroix@lepine-lacroix.info>

	config PACKAGE_ds-lite
		tristate "ds-lite.................. Dual-Stack Lite (DS-Lite) configuration support"
		default y if DEFAULT_ds-lite
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_resolveip
		depends on IPV6
		select PACKAGE_kmod-ip6-tunnel
		help
		 Provides support for Dual-Stack Lite in /etc/config/network.
		 Refer to http://wiki.openwrt.org/doc/uci/network for
		 configuration details.
		 Steven Barth <steven@midlink.org>

	config PACKAGE_etherwake
		tristate "etherwake............... WoL client for magic packets via ethernet frames"
		default y if DEFAULT_etherwake
		default m if ALL
		select PACKAGE_libc
		help
		 You can wake up WOL compliant Computers which have been powered down to
		 	sleep mode or start WOL compliant Computers with a BIOS feature.
		 	WOL is an abbreviation for Wake-on-LAN. It is a standard that allows you
		 	to turn on a computer from another location over a network connection.
		 	ether-wake also supports WOL passwords.
		 http://ftp.debian.org/debian/pool/main/e/etherwake
		 Peter Wagner <tripolar@gmx.at>

	config PACKAGE_etherwake-nfqueue
		tristate "etherwake-nfqueue................... Wake up computers on netfilter match"
		default y if DEFAULT_etherwake-nfqueue
		default m if ALL
		select PACKAGE_nftables-nojson if PACKAGE_nftables-json<PACKAGE_etherwake-nfqueue
		select PACKAGE_kmod-nft-queue
		select PACKAGE_libnetfilter-queue
		select PACKAGE_libc
		depends on !(PACKAGE_nftables-json<PACKAGE_etherwake-nfqueue && IPV6) || IPV6
		help
		 Fork of etherwake with additional support for sending WOL packets
		  when a router added a filtered packet to an NFQUEUE.
		 https://github.com/mister-benjamin/etherwake-nfqueue
		 Mister Benjamin <144dbspl@gmail.com>

	config PACKAGE_ethtool
		tristate "ethtool......................... Display or change ethernet card settings"
		default y if DEFAULT_ethtool
		default m if ALL
		select PACKAGE_libc
		depends on m || (PACKAGE_ethtool-full != y)
		help
		 ethtool is a small utility for examining and tuning your ethernet-based
		  network interface
		 http://www.kernel.org/pub/software/network/ethtool/
		 Felix Fietkau <nbd@nbd.name>

	config PACKAGE_ethtool-full
		tristate "ethtool-full............. Display or change ethernet card settings (full)"
		default y if DEFAULT_ethtool-full
		default m if ALL
		select PACKAGE_libmnl
		select PACKAGE_libc
		help
		 ethtool is a small utility for examining and tuning your ethernet-based
		  network interface
		 http://www.kernel.org/pub/software/network/ethtool/
		 Felix Fietkau <nbd@nbd.name>

	config PACKAGE_gre
		tristate "gre......................... Generic Routing Encapsulation config support"
		default y if DEFAULT_gre
		default m if ALL
		select PACKAGE_resolveip
		select PACKAGE_libc
		select PACKAGE_kmod-gre6 if IPV6
		select PACKAGE_kmod-gre
		help
		 Generic Routing Encapsulation config support (IPv4 and IPv6) in /etc/config/network.
		 Hans Dedecker <dedeckeh@gmail.com>

	config PACKAGE_https-dns-proxy
		tristate "https-dns-proxy..................................... DNS Over HTTPS Proxy"
		default y if DEFAULT_https-dns-proxy
		default m if ALL
		select PACKAGE_sed if !BUSYBOX_DEFAULT_SED
		select PACKAGE_libev
		select PACKAGE_jsonfilter
		select PACKAGE_resolveip
		select PACKAGE_grep if !BUSYBOX_DEFAULT_GREP
		select PACKAGE_libc
		select PACKAGE_libcares
		select PACKAGE_ca-bundle
		select PACKAGE_libcurl
		help
		 Light-weight DNS-over-HTTPS, non-caching translation proxy for the RFC 8484 DoH standard.
		 It receives regular (UDP) DNS requests and resolves them via DoH resolver.
		 Please see https://docs.openwrt.melmac.net/https-dns-proxy/ for more information.
		 https://docs.openwrt.melmac.net/https-dns-proxy/
		 Stan Grishin <stangri@melmac.ca>

	config PACKAGE_ipip
		tristate "ipip...................................... IP in IP Tunnel config support"
		default y if DEFAULT_ipip
		default m if ALL
		select PACKAGE_kmod-ipip
		select PACKAGE_libc
		select PACKAGE_resolveip
		help
		 IP in IP Tunnel config support in /etc/config/network.
		 Hans Dedecker <dedeckeh@gmail.com>

	config PACKAGE_ipset
		tristate "ipset....................................... IPset administration utility"
		default y if DEFAULT_ipset
		default m if ALL
		select PACKAGE_libmnl
		select PACKAGE_libipset
		select PACKAGE_libc
		select PACKAGE_kmod-ipt-ipset
		help
		 IPset administration utility
		 http://ipset.netfilter.org/
		 Jo-Philipp Wich <jo@mein.io>

	config PACKAGE_ipset-dns
		tristate "ipset-dns................. A lightweight DNS forwarder to populate ipsets"
		default y if DEFAULT_ipset-dns
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libmnl
		help
		 The ipset-dns daemon is a lightweight DNS forwarding server that adds all
		  resolved IPs to a given netfilter ipset. It is designed to be used in
		  conjunction with dnsmasq's upstream server directive.
		 
		  Practical use cases include routing over a given gateway traffic for
		  particular web services or webpages that do not have a priori predictable
		  IP addresses and instead rely on dizzying arrays of DNS resolutions.
		 http://git.zx2c4.com/ipset-dns/about/
		 Jo-Philipp Wich <jo@mein.io>

	config PACKAGE_iw
