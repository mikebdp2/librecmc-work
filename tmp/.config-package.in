	menuconfig PACKAGE_lldpd
		tristate "lldpd............................... Link Layer Discovery Protocol daemon"
		default y if DEFAULT_lldpd
		default m if ALL
		select PACKAGE_libnetsnmp if LLDPD_WITH_SNMP
		select PACKAGE_libcap
		select PACKAGE_libbsd if USE_GLIBC
		select PACKAGE_libjson-c if LLDPD_WITH_JSON
		select PACKAGE_libevent2
		select PACKAGE_libc
		help
		 LLDP (Link Layer Discovery Protocol) is an industry standard protocol designed
		 	to supplant proprietary Link-Layer protocols such as
		 	Extreme's EDP (Extreme Discovery Protocol) and
		 	CDP (Cisco Discovery Protocol).
		 	The goal of LLDP is to provide an inter-vendor compatible mechanism to deliver
		 	Link-Layer notifications to adjacent network devices.
		 https://vincentbernat.github.io/lldpd/
		 Stijn Tintel <stijn@linux-ipv6.be>


	source "package/network/services/lldpd/Config.in"

	config PACKAGE_mwan3
		tristate "mwan3........... Multiwan hotplug script with connection tracking support"
		default y if DEFAULT_mwan3
		default m if ALL
		select PACKAGE_iptables-nft if PACKAGE_iptables-zz-legacy<PACKAGE_mwan3
		select PACKAGE_ip6tables-nft if IPV6 && PACKAGE_ip6tables-zz-legacy<PACKAGE_mwan3
		depends on !(IPV6 && PACKAGE_ip6tables-zz-legacy<PACKAGE_mwan3 && IPV6) || IPV6
		select PACKAGE_ipset
		select PACKAGE_libc
		select PACKAGE_iptables-mod-conntrack-extra
		select PACKAGE_ip-tiny if PACKAGE_ip-full<PACKAGE_mwan3
		select PACKAGE_iptables-mod-ipopt
		depends on !(PACKAGE_iptables-zz-legacy<PACKAGE_mwan3 && IPV6) || IPV6
		select PACKAGE_jshn
		depends on !(IPV6 && PACKAGE_ip6tables-zz-legacy<PACKAGE_mwan3) || IPV6
		help
		 Hotplug script which makes configuration of multiple WAN interfaces simple
		 and manageable. With loadbalancing/failover support for up to 250 wan
		 interfaces, connection tracking and an easy to manage traffic ruleset.
		 Florian Eckert <fe@dev.tdt.de>

	config PACKAGE_nstat
		tristate "nstat......................................... Network statistics utility"
		default y if DEFAULT_nstat
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libmnl if (PACKAGE_devlink||PACKAGE_rdma)
		select PACKAGE_libnl-tiny
		help
		 Network statistics utility
		 http://www.linuxfoundation.org/collaborate/workgroups/networking/iproute2
		 Russell Senior <russell@personaltelco.net>

	config PACKAGE_pbr
		tristate "pbr................ Policy Based Routing Service with nft/nft set support"
		default y if DEFAULT_pbr
		default m if ALL
		select PACKAGE_nftables-json
		select PACKAGE_libc
		select PACKAGE_ip-full
		select PACKAGE_kmod-nft-nat
		select PACKAGE_resolveip
		select PACKAGE_jsonfilter
		select PACKAGE_kmod-nft-core
		select PACKAGE_jshn
		help
		 This service enables policy-based routing for WAN interfaces and various VPN tunnels.
		 This version supports OpenWrt with both firewall3/ipset/iptables and firewall4/nft.
		 https://docs.openwrt.melmac.net/pbr/
		 Stan Grishin <stangri@melmac.ca>

	config PACKAGE_pbr-iptables
		tristate "pbr-iptables.... Policy Based Routing Service with iptables/ipset support"
		default y if DEFAULT_pbr-iptables
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_ip-full
		select PACKAGE_resolveip
		select PACKAGE_jsonfilter
		select PACKAGE_iptables-nft if PACKAGE_iptables-zz-legacy<PACKAGE_pbr-iptables
		depends on !(PACKAGE_iptables-zz-legacy<PACKAGE_pbr-iptables && IPV6) || IPV6
		select PACKAGE_ipset
		select PACKAGE_iptables-mod-ipopt
		select PACKAGE_kmod-ipt-ipset
		select PACKAGE_jshn
		help
		 This service enables policy-based routing for WAN interfaces and various VPN tunnels.
		 This version supports OpenWrt with firewall3/ipset/iptables.
		 https://docs.openwrt.melmac.net/pbr/
		 Stan Grishin <stangri@melmac.ca>

	config PACKAGE_rdma
		tristate "rdma................................................ Network rdma utility"
		default y if DEFAULT_rdma
		default m if ALL
		select PACKAGE_libmnl
		select PACKAGE_libc
