		default y if DEFAULT_omcproxy
		default m if ALL
		select PACKAGE_libubus
		select PACKAGE_libc
		select PACKAGE_libubox
		help
		 IGMPv3 and MLDv2 Multicast Proxy
		 Steven Barth <cyrus@openwrt.org>

	config PACKAGE_ppp
