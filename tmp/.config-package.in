		 Vasilis Tsiligiannis <acinonyx@openwrt.gr>

	config PACKAGE_stubby
		tristate "stubby................................ stubby - (daemon that uses getdns)"
		default y if DEFAULT_stubby
		default m if ALL
		select PACKAGE_libyaml
		select PACKAGE_getdns
		select PACKAGE_ca-bundle if PACKAGE_ca-certificates<PACKAGE_stubby
		select PACKAGE_libc
		help
		 This package contains the Stubby daemon (which utilizes the getdns library).
		   See https://github.com/openwrt/packages/blob/master/net/stubby/files/README.md for more details.
		 https://dnsprivacy.org/wiki/display/DP/DNS+Privacy+Daemon+-+Stubby
		 

	config PACKAGE_tor-hs
		tristate "tor-hs................................... Tor hidden service configurator"
		default y if DEFAULT_tor-hs
		default m if ALL
		select PACKAGE_rpcd
		select PACKAGE_libc
		select PACKAGE_tor
		help
		 Tor Hidden Service configurator
		 Jan Pavlinec <jan.pavlinec1@gmail.com>

	config PACKAGE_torsocks
		tristate "torsocks........................................................ torsocks"
		default y if DEFAULT_torsocks
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_tor
		help
		 Torsocks allows you to use most applications in a safe way with Tor.
		  It ensures that DNS requests are handled safely and explicitly rejects any traffic other than TCP from the application you're using.
		 https://trac.torproject.org/projects/tor/wiki/doc/torsocks
		 Jan Pavlinec <jan.pavlinec1@gmail.com>

	config PACKAGE_unbound-anchor
		tristate "unbound-anchor......................... Recursive DNS Server (root DSKEY)"
		default y if DEFAULT_unbound-anchor
		default m if ALL
		select PACKAGE_libexpat
		select OPENSSL_WITH_EC
		select PACKAGE_unbound-daemon
		select PACKAGE_ca-bundle
		select PACKAGE_libopenssl
		select PACKAGE_libc
		help
		 This package contains the Unbound anchor utility.
		 https://nlnetlabs.nl/projects/unbound/about
		 Eric Luehrsen <ericluehrsen@gmail.com>

	config PACKAGE_unbound-checkconf
		tristate "unbound-checkconf.................. Recursive DNS Server (config checker)"
		default y if DEFAULT_unbound-checkconf
		default m if ALL
		select PACKAGE_ca-bundle
		select PACKAGE_libopenssl
		select PACKAGE_libc
		select OPENSSL_WITH_EC
		select PACKAGE_unbound-daemon
		help
		 This package contains the Unbound DNS configuration checker utility.
		 https://nlnetlabs.nl/projects/unbound/about
		 Eric Luehrsen <ericluehrsen@gmail.com>

	config PACKAGE_unbound-control
		tristate "unbound-control.................... Recursive DNS Server (remote control)"
		default y if DEFAULT_unbound-control
		default m if ALL
		select OPENSSL_WITH_EC
		select PACKAGE_unbound-daemon
		select PACKAGE_ca-bundle
		select PACKAGE_libopenssl
		select PACKAGE_libc
		help
		 This package contains the Unbound control utility.
		 https://nlnetlabs.nl/projects/unbound/about
		 Eric Luehrsen <ericluehrsen@gmail.com>

	config PACKAGE_unbound-control-setup
		tristate "unbound-control-setup............... Recursive DNS Server (control setup)"
		default y if DEFAULT_unbound-control-setup
		default m if ALL
		select OPENSSL_WITH_EC
		select PACKAGE_openssl-util
		select PACKAGE_libc
		select PACKAGE_libopenssl
		select PACKAGE_unbound-control
		select PACKAGE_ca-bundle
		help
		 This package contains the Unbound control setup utility.
		 https://nlnetlabs.nl/projects/unbound/about
		 Eric Luehrsen <ericluehrsen@gmail.com>

	config PACKAGE_unbound-daemon
		tristate "unbound-daemon............................. Recursive DNS Server (daemon)"
		default y if DEFAULT_unbound-daemon
		default m if ALL
		select OPENSSL_WITH_EC
		select PACKAGE_libunbound
		select PACKAGE_ca-bundle
		select PACKAGE_libopenssl
		select PACKAGE_libc
		help
		 This package contains the Unbound daemon including 'libevent', 'libmnl', and
		   'libpthread' to better handle large networks with heavy query loads. Options
		   are available under libraries/network/libunbound to custom trim Unbound for
		   smaller targets.
		 https://nlnetlabs.nl/projects/unbound/about
		 Eric Luehrsen <ericluehrsen@gmail.com>

	config PACKAGE_unbound-host
		tristate "unbound-host........................... Recursive DNS Server (DNS lookup)"
		default y if DEFAULT_unbound-host
		default m if ALL
		select PACKAGE_libopenssl
		select PACKAGE_ca-bundle
		select PACKAGE_libunbound
		select PACKAGE_libc
		select OPENSSL_WITH_EC
		help
		 This package contains the Unbound DNS lookup utility.
		 https://nlnetlabs.nl/projects/unbound/about
		 Eric Luehrsen <ericluehrsen@gmail.com>

endmenu
