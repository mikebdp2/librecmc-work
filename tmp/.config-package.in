		 Parallel port interface (PC-style) support
		 

	config PACKAGE_kmod-pcengines-apuv2
		tristate "kmod-pcengines-apuv2..... PC Engines APUv2/3 front button and LEDs driver"
		default y if DEFAULT_kmod-pcengines-apuv2
