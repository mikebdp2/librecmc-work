		 Kernel module for Microchip MCP23xxx I/O expander
		 

	config PACKAGE_kmod-pinctrl-mcp23s08-i2c
		tristate "kmod-pinctrl-mcp23s08-i2c.......... Microchip MCP23xxx I/O expander (I2C)"
		default y if DEFAULT_kmod-pinctrl-mcp23s08-i2c
		default m if ALL||ALL_NONSHARED||ALL_KMODS
		depends on GPIO_SUPPORT
		select PACKAGE_kmod-i2c-core
		select PACKAGE_kmod-pinctrl-mcp23s08
		select PACKAGE_kmod-regmap-i2c
