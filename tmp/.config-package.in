	config PACKAGE_nfs-utils
		tristate "nfs-utils.......................... updated mount utility (includes nfs4)"
		default y if DEFAULT_nfs-utils
		default m if ALL
		select PACKAGE_libblkid
		select PACKAGE_libdevmapper if NFS_KERNEL_SERVER_V4 && PACKAGE_libdevmapper-selinux<PACKAGE_nfs-utils
		depends on !(NFS_KERNEL_SERVER_V4 && PACKAGE_libdevmapper-selinux<PACKAGE_nfs-utils && KERNEL_KEYS) || KERNEL_KEYS
		select PACKAGE_libuuid
		select PACKAGE_libc
		select PACKAGE_libkeyutils if NFS_KERNEL_SERVER_V4
		select PACKAGE_libtirpc
		help
		 Updated mount.nfs command - allows mounting nfs4 volumes
		 http://nfs.sourceforge.net/
		 Peter Wagner <tripolar@gmx.at>

