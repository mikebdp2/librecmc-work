		 Kernel module for 1-wire 4kb EEPROM (DS2433)
		 

	config PACKAGE_kmod-w1-slave-smem
		tristate "kmod-w1-slave-smem............. Simple 64bit memory family implementation"
		default y if DEFAULT_kmod-w1-slave-smem
