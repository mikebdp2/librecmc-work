Package: kmod-zram
Submenu: Other modules
Version: <LINUX_VERSION>-
Depends: 
Conflicts: 
Menu-Depends: 
Provides: 
Section: kernel
Category: Kernel modules
Title: ZRAM
Maintainer: 
Source: 
License: GPL-2.0-only
LicenseFiles: COPYING
Type: ipkg
Kernel-Config: CONFIG_ZSMALLOC CONFIG_ZRAM CONFIG_ZRAM_DEBUG=n CONFIG_ZRAM_WRITEBACK=n CONFIG_ZSMALLOC_STAT=n
Description:  Compressed RAM block device support

@@
Config:
  if PACKAGE_kmod-zram
    choice
      prompt "ZRAM Default compressor"
      default ZRAM_DEF_COMP_LZORLE

    config ZRAM_DEF_COMP_LZORLE
            bool "lzo-rle"
            select PACKAGE_kmod-lib-lzo

    config ZRAM_DEF_COMP_LZO
            bool "lzo"
            select PACKAGE_kmod-lib-lzo

    config ZRAM_DEF_COMP_LZ4
            bool "lz4"
            select PACKAGE_kmod-lib-lz4

    config ZRAM_DEF_COMP_LZ4HC
            bool "lz4-hc"
            select PACKAGE_kmod-lib-lz4hc

    config ZRAM_DEF_COMP_ZSTD
            bool "zstd"
            select PACKAGE_kmod-lib-zstd

    endchoice
  endif
@@

