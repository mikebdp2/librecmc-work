Maintainer: libreCMC LuCI community
Source: 
License: MIT
Type: ipkg
Description: LuCI core runtime
https://github.com/librecmc/luci
libreCMC LuCI community
@@
Config:
   config LUCI_SRCDIET
	bool "Minify Lua sources"
	default n

   config LUCI_JSMIN
	bool "Minify JavaScript sources"
	default y

   config LUCI_CSSTIDY
	bool "Minify CSS files"
	default y

   menu "Translations"

     config LUCI_LANG_ar
	   tristate "Arabic (ar)" 

     config LUCI_LANG_bg
	   tristate "Bulgarian (bg)" 

     config LUCI_LANG_bn_BD
	   tristate "Bengali (bn_BD)" 

     config LUCI_LANG_ca
	   tristate "Catalan (ca)" 

     config LUCI_LANG_cs
	   tristate "Czech (cs)" 

     config LUCI_LANG_da
	   tristate "Danish (da)" 

     config LUCI_LANG_de
	   tristate "German (de)" 

     config LUCI_LANG_el
	   tristate "Greek (el)"  

     config LUCI_LANG_es
	   tristate "Spanish (es)" 

     config LUCI_LANG_fi
	   tristate "Finnish (fi)" 

     config LUCI_LANG_fr
	   tristate "French (fr)" 

     config LUCI_LANG_he
	   tristate "Hebrew (he)" 

     config LUCI_LANG_hi
	   tristate "Hindi (hi)" 

     config LUCI_LANG_hu
	   tristate "Hungarian (hu)" 

     config LUCI_LANG_it
	   tristate "Italian (it)" 

     config LUCI_LANG_ja
	   tristate "Japanese (ja)" 

     config LUCI_LANG_ko
	   tristate "Korean (ko)" 

     config LUCI_LANG_lt
	   tristate "Lithuanian (lt)" 

     config LUCI_LANG_mr
	   tristate "Marathi (mr)" 

     config LUCI_LANG_ms
	   tristate "Malay (ms)" 

     config LUCI_LANG_nb_NO
	   tristate "Norwegian (nb_NO)" 

     config LUCI_LANG_nl
	   tristate "Dutch (nl)" 

     config LUCI_LANG_pl
	   tristate "Polish (pl)" 

     config LUCI_LANG_pt
	   tristate "Portuguese (pt)" 

     config LUCI_LANG_pt_BR
	   tristate "Brazilian Portuguese (pt_BR)" 

     config LUCI_LANG_ro
	   tristate "Romanian (ro)" 

     config LUCI_LANG_ru
